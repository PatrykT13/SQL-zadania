CREATE DATABASE Lista_Prezentów;

USE Lista_Prezentów;
CREATE TABLE Prezenty_2020 (
ID INTEGER PRIMARY KEY,
Imię_obdarowanego VARCHAR (50) NOT NULL,
Pomysł_na_prezent VARCHAR (50) NOT NULL,
Cena DECIMAL(10, 2) NOT NULL CHECK (Cena >= 0),
Miejsce_zakupu VARCHAR (50) NOT NULL);


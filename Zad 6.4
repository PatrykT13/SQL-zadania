SELECT * FROM aggregates.batman;

SELECT start_date,
YEAR(start_date) AS rok,
MONTH(start_date) AS miesiac,
DAY(start_date) AS dzien
FROM aggregates.batman;


SELECT start_date, DATE_ADD(start_date, INTERVAL 3 DAY) AS final_date
FROM aggregates.batman;

SELECT CURRENT_DATE() AS dzisiejsza_data

SELECT MONTHNAME(CURRENT_DATE) AS miesiac

SELECT start_date, WEEK(start_date) AS nr_tygodnia, MONTHNAME(start_date) AS miesiac, QUARTER(start_date) AS kwartal, DAY(start_date) nr_dnia
FROM aggregates.batman;
